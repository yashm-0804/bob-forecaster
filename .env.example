# Copy to .env and fill in only what you need: `cp .env.example .env`.
# .env is git-ignored. Never commit real values. Every line is optional:
# without any of them the console still runs on the committed replays.

# Gemini drafting and translation (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: a key from another Cloud project, used only when the first runs out of quota
GEMINI_API_KEY_2=

# Your own Google Cloud project, registered for Earth Engine
# (https://code.earthengine.google.com/register), after `earthengine authenticate`
EE_PROJECT=

# Keep approvals in BigQuery instead of a local SQLite file
# (make the table first: .venv/bin/python scripts/bigquery_setup.py <project>)
# BOB_AUDIT_STORE=bigquery
# BOB_BQ_AUDIT_TABLE=<project>.bob_forecaster.audit_events

# Officers sign in with Google (Firebase Authentication); see DEPLOY.md
# BOB_FIREBASE_PROJECT=
# BOB_FIREBASE_API_KEY=
# BOB_FIREBASE_APP_ID=
# BOB_OPERATORS=officer@example.gov.in,@example.org
